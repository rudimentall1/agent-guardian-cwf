{
  "name": "agent-guardian-cwf",
  "version": "0.1.0",
  "description": "Security infrastructure for autonomous AI agents: policy enforcement, transaction simulation, and on-chain wallet protection.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "compile": "hardhat clean && hardhat compile",
    "test": "hardhat test && node scripts/run-cwf-tests.js",
    "test:contracts": "hardhat test",
    "test:cwf": "node scripts/run-cwf-tests.js",
    "test:hardhat": "hardhat test && node scripts/run-cwf-tests.js",
    "test:cwf:intent": "hardhat test runtime-test/intent.test.ts",
    "test:risk": "hardhat test runtime-test/risk.test.ts",
    "benchmark:10k": "hardhat run benchmark/run-10k.ts",
    "benchmark:real100": "hardhat run --network arbitrumSepolia benchmark/run-real-100.ts",
    "coverage": "hardhat coverage",
    "build:dashboard": "vite build",
    "dashboard": "vite",
    "start:api": "ts-node api/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudimentall1/agent-guardian-cwf.git"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "web3",
    "arbitrum",
    "smart-wallet",
    "security-infrastructure"
  ],
  "author": "Rudimentall",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rudimentall1/agent-guardian-cwf/issues"
  },
  "homepage": "https://github.com/rudimentall1/agent-guardian-cwf#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^5.0.2",
    "hardhat": "^2.29.1",
    "solc": "^0.8.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}